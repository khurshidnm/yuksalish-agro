{
  "name": "@yap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:setup": "tsx --env-file=../../.env src/db/setup.ts",
    "db:seed": "tsx --env-file=../../.env src/seed/index.ts",
    "db:reset": "tsx --env-file=../../.env src/db/setup.ts --reset && tsx --env-file=../../.env src/seed/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "ai:check": "tsx --env-file=../../.env src/modules/ai/provider/check.ts",
    "ai:eval": "tsx --env-file=../../.env eval/assistant.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.7",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.2",
    "@google/genai": "^2.32.0",
    "@yap/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.4",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "geotiff": "3.0.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "openapi-types": "^12.1.3",
    "otplib": "^13.6.0",
    "pdfmake": "^0.3.13",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "proj4": "2.22.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
