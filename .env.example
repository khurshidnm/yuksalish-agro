# ─── Database ──────────────────────────────────────────────────────────────
# App connects with a NON-owner role so that row-level security is enforced.
DATABASE_URL=postgres://yap_app:yap_app_dev@localhost:5434/yap
# Owner role: schema setup and seed only. Never used by the running API.
DATABASE_OWNER_URL=postgres://yap:yap_dev@localhost:5434/yap
REDIS_URL=redis://localhost:6381

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── File storage ──────────────────────────────────────────────────────────
# local = files on disk (development). s3 = any S3-compatible store (MinIO etc.)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=yap
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Integrations (all optional; features degrade gracefully when unset) ───
# Telegram: without a token, messages are written to the API log instead.
TELEGRAM_BOT_TOKEN=
# Telegram chat that is told about each new enquiry from the website. Needs the bot token above.
LEADS_TELEGRAM_CHAT_ID=
# AI assistant, one of the two. Without a key, the assistant says it is not configured and
# statistical insights keep working. Gemini is used first when both are set; AI_PROVIDER overrides.
# Gemini must use a key from a billing-enabled Google project: on the free tier Google may use
# prompts and answers to improve its products, which spec 15.2 forbids for farm data.
GEMINI_API_KEY=
# Set to true once the key is on a paid project. Production refuses Gemini without it.
GEMINI_PAID_TIER=
ANTHROPIC_API_KEY=
# AI_PROVIDER=gemini
# Optional tuning. Defaults are in apps/api/src/modules/ai; these only override them.
# AI_MODEL=gemini-3.8-flash
# AI_THINKING_BUDGET=1024
# AI_EFFORT=
# AI_CHAT_PER_MINUTE=
# AI_CHAT_PER_DAY=

# Public website. These go into the prerendered pages at build time, so changing one means a rebuild.
# VITE_SITE_URL is the address search engines should use, without a trailing slash. Without it the
# pages have no canonical links, hreflang, structured data or sitemap.
VITE_SITE_URL=
# Shown on the page exactly as written, for example +998 90 123 45 67. Left out of the page if empty.
VITE_CONTACT_PHONE=
# Telegram username, without the @. Left out of the page if empty.
VITE_CONTACT_TELEGRAM=
