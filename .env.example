# ─── Database ──────────────────────────────────────────────────────────────
# App connects with a NON-owner role so that row-level security is enforced.
DATABASE_URL=postgres://yap_app:yap_app_dev@localhost:5434/yap
# Owner role: schema setup and seed only. Never used by the running API.
DATABASE_OWNER_URL=postgres://yap:yap_dev@localhost:5434/yap
REDIS_URL=redis://localhost:6381

# ─── API ───────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── File storage ──────────────────────────────────────────────────────────
# local = files on disk (development). s3 = any S3-compatible store (MinIO etc.)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=yap
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Integrations (all optional; features degrade gracefully when unset) ───
# Telegram: without a token, messages are written to the API log instead.
TELEGRAM_BOT_TOKEN=
# AI assistant: without a key, the assistant reports that it is not configured.
ANTHROPIC_API_KEY=
# Optional tuning. Defaults are in apps/api/src/modules/ai; these only override them.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=
# AI_CHAT_PER_MINUTE=
# AI_CHAT_PER_DAY=
