# Do not copy this by hand: infra/init-env.sh <domain> writes .env.production with fresh secrets and
# memory settings for this server. Never commit the filled copy. docs/deployment.md explains each part.
# Each secret comes from: openssl rand -hex 32
# Hex matters for the database and Redis passwords: they are placed inside connection URLs.

POSTGRES_PASSWORD=
YAP_APP_PASSWORD=
YAP_AI_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# The name of the app without https://, for example app.yuksalish.uz. It must already point at this
# server: Caddy uses it to get the certificate.
DOMAIN=
# Public address of the app, exactly as users type it: https:// and the same name as DOMAIN.
WEB_ORIGIN=https://app.example.uz
# caddy: docker-compose.tls.yml gets and renews the certificate. external: your own proxy does TLS.
TLS_MODE=caddy
# Loopback port of the web container. Caddy does not use it; deploy checks and your own proxy can.
WEB_PORT=8080

# First deploy only: the platform admin who creates tenants. The phone is written exactly as
# +998901234567. The password has at least 12 characters and goes in single quotes, because compose
# would read a $ in it as a variable. An existing user is left untouched, so remove both after the
# first start.
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=''

# Backups. A copy on this disk does not survive losing this disk. BACKUP_OFFSITE says where they go:
#   user@host:path   rsync over SSH to a machine in Uzbekistan (personal data stays in the country)
#   /mnt/some-disk   a disk that is mounted here but is not this server's own disk
#   pull             another machine fetches them. Read "Backups" in docs/deployment.md first.
BACKUP_OFFSITE=
BACKUP_PASSPHRASE_FILE=/etc/yap/backup.key
BACKUP_SSH_KEY=/etc/yap/backup_ssh_key
BACKUP_DIR=/var/backups/yap
# Telegram chat told when a backup or its copy fails, or the watchdog restarts a frozen API. Needs
# TELEGRAM_BOT_TOKEN. Sending does not disturb the bot's polling.
BACKUP_ALERT_CHAT_ID=
# Two outside checks, each with its own address, because this server cannot report its own death.
# HEARTBEAT_URL is pinged every minute while the deep health check passes. BACKUP_HEARTBEAT_URL is
# pinged once a day when a real restore of the newest backup passes. See "Check on day one".
HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=

# File storage. local keeps files in the `files` volume; s3 uses any S3-compatible store.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=yap
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Integrations. Each stays off while empty; the app keeps working without them.
TELEGRAM_BOT_TOKEN=
# Telegram chat that is told about each new enquiry from the website. Needs the bot token above.
LEADS_TELEGRAM_CHAT_ID=
# AI assistant: one of these. Gemini needs a billing-enabled project, then GEMINI_PAID_TIER=true:
# on the free tier Google may use prompts and answers to improve its products (spec 15.2).
GEMINI_API_KEY=
GEMINI_PAID_TIER=
ANTHROPIC_API_KEY=
# gemini or claude. Only needed when both keys are set; Gemini is the default.
AI_PROVIDER=
# Optional tuning. Empty keeps the defaults in apps/api/src/modules/ai.
AI_MODEL=
# Gemini only.
AI_THINKING_BUDGET=
# Claude only: low, medium, high, xhigh or max.
AI_EFFORT=
# Questions to the assistant per person. Telegram voice notes are limited the same way.
AI_CHAT_PER_MINUTE=
AI_CHAT_PER_DAY=

# true serves the API reference at /api/docs. Anyone can read it there, so leave it empty unless
# someone needs it for a while. docs/api.md explains the reference.
API_DOCS=

# Public website. These go into the prerendered pages at build time, so changing one means a rebuild.
# VITE_SITE_URL is the address search engines should use, without a trailing slash. Without it the
# pages have no canonical links, hreflang, structured data or sitemap.
VITE_SITE_URL=
# Shown on the page exactly as written, for example +998 90 123 45 67. Left out of the page if empty.
VITE_CONTACT_PHONE=
# Telegram username, without the @. Left out of the page if empty.
VITE_CONTACT_TELEGRAM=

# Memory. infra/init-env.sh sizes these for this server, and infra/init-env.sh --resize does it again
# after a server upgrade. Empty keeps the defaults in docker-compose.prod.yml, which suit 8 GB.
DB_MEM_LIMIT=
API_MEM_LIMIT=
API_HEAP_MB=
REDIS_MEM_LIMIT=
REDIS_MAXMEMORY=
WEB_MEM_LIMIT=
CADDY_MEM_LIMIT=
PG_SHARED_BUFFERS=
PG_EFFECTIVE_CACHE_SIZE=
PG_WORK_MEM=
PG_MAINTENANCE_WORK_MEM=
