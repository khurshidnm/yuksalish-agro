# Copy to .env.production in the repository root. Never commit the filled copy.
# Generate each secret with: openssl rand -hex 32
# Hex matters for the database and Redis passwords: they are placed inside connection URLs.

POSTGRES_PASSWORD=
YAP_APP_PASSWORD=
YAP_AI_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Public address of the app, exactly as users type it.
WEB_ORIGIN=https://app.example.uz
# Loopback port for the TLS proxy in front of the web container.
WEB_PORT=8080

# First deploy only: the platform admin who creates tenants. Password at least 12 characters.
# An existing user is left untouched, so these can be removed after the first start.
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=

# File storage. local keeps files in the `files` volume; s3 uses any S3-compatible store.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=yap
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Integrations. Each stays off while empty; the app keeps working without them.
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=
